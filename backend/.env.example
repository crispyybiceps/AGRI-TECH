# Core Security & Database
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=sqlite:///./agritech.db
OTP_EXPIRY_MINUTES=5
ACCESS_TOKEN_EXPIRE_DAYS=7

# Item 1: Real OTP Provider (mock | twilio | msg91)
# When set to mock, OTP is printed to console log labeled [MOCK OTP]
OTP_PROVIDER=mock

# Twilio SMS Credentials (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# MSG91 Indian SMS Gateway Credentials (if OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=AGRITC
MSG91_TEMPLATE_ID=your_dlt_approved_template_id_here

# Item 2: Weather Debug Flag (false = live Open-Meteo -> cache -> stale cache; true = mock)
DEBUG_MOCK=false

# Item 3 & 6: Claude AI (Anthropic Vision OCR & Assistant)
# Without this key, chatbot runs safe rule-based expert engine labeled "Basic mode (AI offline)"
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Item 7: data.gov.in Agmarknet Daily Mandi API
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Item 9: Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
