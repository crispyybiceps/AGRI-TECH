  "amendments": {
    "acidic": {
      "condition": "pH < 6.5",
      "advice_en": "Apply agricultural lime (calcium carbonate) or dolomite at 200-400 kg/acre to neutralize acidity and improve nutrient uptake.",
      "advice_hi": "मिट्टी की अम्लता दूर करने के लिए प्रति एकड़ 200-400 किलोग्राम कृषि चूना (लाइम) डालें।",
      "advice_mr": "जमिनीचा आम्लधर्मीपणा कमी करण्यासाठी एकरी २०० ते ४०० किलो कृषी चुना किंवा डोलोमाइट वापरा."
    },
    "sodic": {
      "condition": "pH > 8.5",
      "advice_en": "Apply agricultural gypsum (500-1000 kg/acre) followed by heavy irrigation and drainage to leach out excess sodium salts.",
      "advice_hi": "अत्यधिक क्षारीयता कम करने के लिए प्रति एकड़ 500-1000 किलो जिप्सम डालें और खेत से पानी निकालने की नाली बनाएं।",
      "advice_mr": "चोपडी व क्षारयुक्त जमीन सुधारण्यासाठी एकरी ५०० ते १००० किलो जिप्सम टाकून शेतात पाणी भरून निचरा करावा."
    },
    "low_organic_carbon": {
      "condition": "Organic Carbon < 0.50%",
      "advice_en": "Incorporate 4-5 tonnes of well-decomposed Farmyard Manure (FYM), vermicompost, or green manure (Dhaincha/Sunhemp) to rebuild soil humus.",
      "advice_hi": "मिट्टी की जैविक शक्ति बढ़ाने के लिए प्रति एकड़ 4-5 टन गोबर की सड़ी खाद या केंचुआ खाद डालें।",
      "advice_mr": "जमिनीतील सेंद्रिय कर्ब वाढवण्यासाठी एकरी ४-५ टन चांगले कुजलेले शेणखत, गांडूळ खत किंवा ताग/धैंचाचे हिरवळीचे खत गाडा."
    }
